{
  "version": "1.0",
  "authority": "docs/agents/FACTORY_SETUP_GUIDE.md",
  "policy": "Every Cloud Agent factory automation is defined here. Dashboard setup must match this catalog.",
  "environment": {
    "dashboard_url": "https://cursor.com/dashboard/cloud-agents/environments/r/github.com/vivivieri/3d-jrpg-adventure-pc-game",
    "branch": "game/development",
    "environment_json": ".cursor/environment.json",
    "boot_checks": [
      "bash tools/check_snapshot_boot.sh",
      "bash tools/check_mcp_ready.sh"
    ],
    "snapshot_required_roles": [
      "architect",
      "builder",
      "qa",
      "flow",
      "visual",
      "release"
    ]
  },
  "dispatch": {
    "trigger_label": "dispatch/ready",
    "in_progress_label": "status/in-progress",
    "command": "bash tools/pm_dispatch_workers.py",
    "manifest_path": "artifacts/worker_dispatch_manifest.json"
  },
  "automations": [
    {
      "id": "automation_a_pm",
      "name": "PM — cycle dispatch",
      "role": "pm",
      "required": true,
      "cursor_dashboard": "https://cursor.com/automations",
      "trigger": {
        "type": "webhook",
        "secret": "CURSOR_PM_CYCLE_WEBHOOK_URL",
        "schedule_allowed": false
      },
      "repo": "3d-JRPG-adventure-pc-game",
      "branch": "game/development",
      "prompt_file": "docs/agents/automation_prompts/pm_cycle_dispatch.md",
      "first_command": "bash tools/run_pm_orchestrator.sh",
      "post_orchestrator_command": "python3 tools/pm_dispatch_workers.py",
      "mcp_required": false,
      "snapshot_mode": "prefer"
    },
    {
      "id": "automation_b_ci_triage",
      "name": "Game CI failure triage",
      "role": "pm",
      "required": true,
      "trigger": {
        "type": "github_ci",
        "workflow": "Game CI",
        "conclusion": "failure",
        "branch": "game/development"
      },
      "github_workflow": ".github/workflows/game-ci-failure-triage.yml",
      "prompt_file": "docs/agents/automation_prompts/ci_failure_triage.md",
      "mcp_required": false
    },
    {
      "id": "automation_c_uat",
      "name": "Human UAT notify",
      "role": "human_notify",
      "required": false,
      "trigger": {
        "type": "webhook",
        "event": "uat_ready"
      },
      "prompt_file": "docs/agents/automation_prompts/uat_notify.md",
      "mcp_required": false
    },
    {
      "id": "automation_d_factory_alert",
      "name": "Factory — human alert",
      "role": "human_notify",
      "required": true,
      "trigger": {
        "type": "webhook",
        "secret": "CURSOR_FACTORY_ALERT_WEBHOOK_URL",
        "events": ["factory_halt", "mcp_blocked"]
      },
      "prompt_file": "docs/agents/automation_prompts/factory_alert.md",
      "mcp_required": false
    },
    {
      "id": "automation_e_worker",
      "name": "Worker — sprint issue",
      "role": "worker",
      "required": true,
      "trigger": {
        "type": "webhook",
        "secret": "CURSOR_WORKER_WEBHOOK_URL",
        "fallback_github_workflow": ".github/workflows/worker-dispatch.yml",
        "note": "Cursor UI may only expose PR label triggers; use webhook + GitHub Actions issues.labeled bridge"
      },
      "repo": "3d-JRPG-adventure-pc-game",
      "branch": "game/development",
      "prompt_file": "docs/agents/automation_prompts/worker_sprint_issue.md",
      "mcp_required": true,
      "snapshot_mode": "required"
    }
  ],
  "worker_roles": [
    "architect",
    "builder",
    "qa",
    "flow",
    "visual",
    "release",
    "analyst"
  ],
  "github_labels": [
    "dispatch/ready",
    "status/in-progress",
    "agent/architect",
    "agent/builder",
    "agent/qa",
    "agent/flow",
    "agent/visual",
    "agent/release",
    "agent/pm",
    "agent/analyst"
  ]
}
